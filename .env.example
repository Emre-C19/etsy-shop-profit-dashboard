# Copy this file to .env and fill in your own values. Never commit .env.
# Find these under "Your Apps" in the Etsy Developer Portal.
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=

# Must match the callback URL registered for your app.
ETSY_REDIRECT_URI=http://localhost:3003/callback

# Where synced data and the OAuth token are stored on your machine.
ETSY_PROFIT_DATA_DIR=data
